    {
      "parameters": {
        "jsCode": "const filas = $input.all().map(i => i.json);\nconst general = (filas.find(f => f.tipo_documento === '_General') || {}).instrucciones || '';\nconst tipos = filas.filter(f => f.tipo_documento && f.tipo_documento !== '_General' && String(f.activo).toUpperCase() === 'SI');\nconst lista = tipos.map(t => '- \"' + t.tipo_documento + '\"').concat(['- \"Otro\" (si no encaja en ninguno)']).join('\\n');\nconst bloques = tipos.map(t => 'Si es \"' + t.tipo_documento + '\":\\n' + (t.campos || '') + (t.instrucciones ? '\\n' + t.instrucciones : '')).join('\\n\\n');\nconst docs = $('Extraer texto Gmail').all();\nconst files = $('Separar adjuntos PDF').all();\nreturn docs.map((d, i) => {\n  const id = String(i + 1);\n  const texto = d.json.text || '';\n  const prompt_base = general\n    + '\\n\\nPASO 1 - Identifica el tipo de documento con uno de estos valores exactos:\\n' + lista\n    + '\\n\\nPASO 2 - Extrae en \"datos_relevantes\" solo los campos del tipo identificado:\\n\\n' + bloques\n    + '\\n\\nSi es \"Otro\": datos_relevantes = null.'\n    + '\\n\\nFORMATO DE SALIDA:\\nDevuelve únicamente un JSON válido, sin texto antes ni después y sin bloques de código markdown, con esta estructura:\\n'\n    + '{\"id_interno\": \"' + id + '\", \"tipo_documento\": \"uno de los valores de PASO 1\", \"fecha_documento\": \"YYYY-MM-DD o null\", \"confianza\": \"alta | media | baja\", \"datos_relevantes\": { ... }}'\n    + '\\nEl campo id_interno debe ser exactamente \"' + id + '\".';\n  const archivo = files[i] && files[i].binary && files[i].binary.data ? files[i].binary.data.fileName : null;\n  return { json: { id, origen: 'gmail', archivo: archivo || null, caracteres: texto.length, text: texto, prompt_base } };\n});"
      },
