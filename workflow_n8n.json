        "jsCode": "const salida = [];\nfor (const item of $input.all()) {\n  for (const key of Object.keys(item.binary || {})) {\n    const archivo = item.binary[key];\n    const esPdf = archivo.mimeType === 'application/pdf'\n      || (archivo.fileName || '').toLowerCase().endsWith('.pdf');\n    if (esPdf) {\n      salida.push({ json: { formulario_fecha: item.json.submittedAt || null }, binary: { data: archivo } });\n    }\n  }\n}\nreturn salida;"
