    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parts = ($input.item.json.content && $input.item.json.content.parts) || [];\nconst texto = parts.map(p => p.text || '').join('').replace(/```json/gi, '').replace(/```/g, '').trim();\nlet datos;\ntry {\n  datos = JSON.parse(texto);\n} catch (error) {\n  datos = { tipo_documento: 'Error', motivo: 'JSON no válido: ' + error.message, texto_original: texto.slice(0, 500) };\n}\nconst metas = $('Construir prompt Gmail').all().map(i => i.json);\nlet meta = metas.find(m => m.id === String(datos.id_interno));\nif (!meta && datos.id_interno === undefined && metas.length === 1) meta = metas[0];\nmeta = meta || {};\nreturn { json: {\n  ...datos,\n  archivo: meta.archivo || null,\n  origen: meta.origen || 'desconocido',\n  caracteres: meta.caracteres || null,\n  tokens_estimados: meta.caracteres ? Math.round(meta.caracteres / 4) : null\n} };"
      },
