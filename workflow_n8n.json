    {
      "parameters": {
        "jsCode": "let newItems = [];\nfor (let item of $input.all()) {\n  if (item.binary) {\n    for (let key of Object.keys(item.binary)) {\n      const archivo = item.binary[key];\n      const esPdf = archivo.mimeType === 'application/pdf'\n        || (archivo.fileName || '').toLowerCase().endsWith('.pdf');\n      if (key.startsWith('attachment_') && esPdf) {\n        newItems.push({ json: item.json, binary: { data: archivo } });\n      }\n    }\n  }\n}\nreturn newItems;"
      },
